{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Source Record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "provider": { "type": "string", "minLength": 1 },
    "source_type": {
      "enum": [
        "official",
        "enterprise_provider",
        "midmarket_provider",
        "historical_archive",
        "secondary"
      ]
    },
    "external_ref": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri", "minLength": 1 },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "document_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "attribution": { "type": "string", "minLength": 1 },
    "license_class": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  },
  "required": [
    "source_record_id",
    "provider",
    "source_type",
    "external_ref",
    "url",
    "retrieved_at",
    "document_hash",
    "attribution"
  ]
}
