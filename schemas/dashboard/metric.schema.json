{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "unit": { "type": "string" },
    "direction": { "enum": ["higher", "lower"] },
    "left": { "$ref": "canonical-metric.schema.json" },
    "right": { "$ref": "canonical-metric.schema.json" },
    "leader": { "enum": ["left", "right", null] },
    "comparison": { "type": "string", "minLength": 1 }
  },
  "required": [
    "id",
    "label",
    "unit",
    "direction",
    "left",
    "right",
    "leader",
    "comparison"
  ]
}
