{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Provenance",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provenance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "source_record_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "review_status": { "enum": ["pending", "accepted", "rejected"] },
    "review_reason": { "type": "string", "minLength": 1 }
  },
  "required": [
    "provenance_id",
    "source_record_id",
    "retrieved_at",
    "review_status",
    "review_reason"
  ]
}
