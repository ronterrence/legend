{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "freshness": {
      "type": "string",
      "enum": [
        "B0",
        "B1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "demo",
        "verified"
      ]
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scopeId": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "enum": [
            "completed_editions",
            "current_season"
          ]
        },
        "cutoffAt": {
          "type": "string",
          "format": "date-time"
        },
        "editions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "competition": {
                "type": "string",
                "minLength": 1
              },
              "season": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "completed",
                  "in_progress"
                ]
              },
              "matchSetId": {
                "type": "string",
                "minLength": 1
              },
              "startAt": {
                "type": "string",
                "format": "date-time"
              },
              "endAt": {
                "type": "string",
                "format": "date-time"
              },
              "matchSetHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "competition",
              "season",
              "status",
              "matchSetId"
            ]
          },
          "minItems": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validated": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "scopeId",
        "policy",
        "cutoffAt",
        "editions",
        "exclusions",
        "validated"
      ]
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "initials": {
            "type": "string",
            "minLength": 1
          },
          "number": {
            "type": "integer"
          },
          "accent": {
            "type": "string",
            "enum": [
              "coral",
              "mint"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "country",
          "initials",
          "number",
          "accent"
        ]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "enum": [
              "fixture",
              "rsssf",
              "transfermarkt",
              "api-football"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "documentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "provider",
          "url",
          "retrievedAt",
          "attribution",
          "documentHash"
        ]
      },
      "minItems": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "playerId": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "enum": [
              "appearances",
              "goals",
              "assists",
              "minutes",
              "penalty_goals",
              "club_trophies",
              "international_trophies",
              "awards"
            ]
          },
          "category": {
            "type": "string",
            "enum": ["overall", "friendly", "world_cup", "continental", "qualifier", "other"]
          },
          "value": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "scopeId": {
            "type": "string",
            "minLength": 1
          },
          "matchSetId": {
            "type": "string",
            "minLength": 1
          },
          "definitionVersion": {
            "const": "v1"
          },
          "coverage": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unknown"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "review": {
            "type": "string",
            "enum": [
              "accepted",
              "pending",
              "rejected"
            ]
          },
          "reviewReason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "playerId",
          "metric",
          "value",
          "scopeId",
          "matchSetId",
          "definitionVersion",
          "coverage",
          "sourceIds",
          "review",
          "reviewReason"
        ]
      }
    }
  },
  "required": [
    "id",
    "label",
    "freshness",
    "kind",
    "publishedAt",
    "manifest",
    "players",
    "sources",
    "observations"
  ]
}
