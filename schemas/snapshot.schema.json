{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Snapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "snapshot_type": { "enum": ["FINAL", "CURRENT", "LIVE"] },
    "season": { "type": "string", "minLength": 1 },
    "published_at": { "type": "string", "format": "date-time" },
    "immutable": { "const": true },
    "sporting_cutoff_at": { "type": "string", "format": "date-time" },
    "supersedes": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "metric_definition_version": { "type": "string", "minLength": 1 },
    "source_set_version": { "type": "string", "minLength": 1 },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_id": { "type": "string", "minLength": 1 },
        "editions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "edition_id": { "type": "string", "minLength": 1 },
              "competition_id": { "type": "string", "minLength": 1 },
              "competition_name": { "type": "string", "minLength": 1 },
              "season": { "type": "string", "minLength": 1 },
              "status": { "enum": ["completed", "in_progress"] },
              "start_at": { "type": "string", "format": "date-time" },
              "end_at": { "type": "string", "format": "date-time" },
              "match_set_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "covered_matches": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "match_id": { "type": "string", "minLength": 1 },
                    "finished_at": { "type": "string", "format": "date-time" }
                  },
                  "required": ["match_id", "finished_at"]
                }
              }
            },
            "required": [
              "edition_id",
              "competition_id",
              "competition_name",
              "season",
              "status",
              "start_at",
              "end_at",
              "match_set_hash",
              "covered_matches"
            ]
          }
        },
        "exclusions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["manifest_id", "editions", "exclusions"]
    }
  },
  "required": [
    "snapshot_id",
    "snapshot_type",
    "season",
    "published_at",
    "immutable",
    "sporting_cutoff_at",
    "coverage"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "snapshot_type": { "const": "FINAL" } },
        "required": ["snapshot_type"]
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "editions": {
                "items": {
                  "properties": { "status": { "const": "completed" } }
                }
              }
            }
          }
        }
      }
    }
  ]
}
