                "additionalProperties": false,
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "numerator": {
                            "type": "string",
                            "pattern": "^[0-9]+$"
                          },
                          "denominator": {
                            "type": "string",
                            "pattern": "^[1-9][0-9]*$"
                          }
                        },
                        "required": [
                          "numerator",
                          "denominator"
                        ]
                      }
                    ]
                  },
                  "display": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "available",
                      "unavailable",
                      "undefined",
                      "invalid"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "sourceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "value",
                  "display",
                  "status",
                  "reason",
                  "sourceIds"
                ]
              },
              "right": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "numerator": {
                            "type": "string",
                            "pattern": "^[0-9]+$"
                          },
                          "denominator": {
                            "type": "string",
                            "pattern": "^[1-9][0-9]*$"
                          }
                        },
                        "required": [
                          "numerator",
                          "denominator"
                        ]
                      }
                    ]
                  },
                  "display": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "available",
                      "unavailable",
                      "undefined",
                      "invalid"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "sourceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "value",
                  "display",
                  "status",
                  "reason",
                  "sourceIds"
                ]
              },
              "leader": {
                "enum": [
                  "left",
                  "right",
                  null
                ]
              },
              "comparison": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label",
              "formula",
              "unit",
              "direction",
              "left",
              "right",
              "leader",
              "comparison"
            ]
          }
        },
        "international": {
          "$ref": "international.schema.json"
        }
      },
      "required": [
        "overview",
        "efficiency",
        "international"
      ]
    },
    "narrative": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "createdAt",
    "snapshotId",
    "label",
    "freshness",
    "kind",
    "scopeId",
    "cutoffAt",
    "coverage",
    "definitionVersion",
    "rendererVersion",
    "players",
    "sources",
    "pages",
    "narrative"
  ]
}
