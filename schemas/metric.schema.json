{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "formula": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string"
    },
    "direction": {
      "enum": [
        "higher",
        "lower"
      ]
    },
    "left": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "numerator": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "denominator": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                }
              },
              "required": [
                "numerator",
                "denominator"
              ]
            }
          ]
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "undefined",
            "invalid"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "value",
        "display",
        "status",
        "reason",
        "sourceIds"
      ]
    },
    "right": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "numerator": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "denominator": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                }
              },
              "required": [
                "numerator",
                "denominator"
              ]
            }
          ]
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "available",
            "unavailable",
            "undefined",
            "invalid"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "value",
        "display",
        "status",
        "reason",
        "sourceIds"
      ]
    },
    "leader": {
      "enum": [
        "left",
        "right",
        null
      ]
    },
    "comparison": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "label",
    "formula",
    "unit",
    "direction",
    "left",
    "right",
    "leader",
    "comparison"
  ]
}
