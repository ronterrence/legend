{
  "name": "legend-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/api/server.ts",
    "start": "tsx --env-file-if-exists=.env src/api/server.ts --production",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "validate": "tsx src/cli.ts validate",
    "import": "tsx src/cli.ts import",
    "inspect:rsssf": "tsx src/cli.ts rsssf",
    "collect:rsssf": "tsx src/ingestion/collect-rsssf.ts",
    "prepare:b0": "tsx src/ingestion/build-b0-international.ts",
    "provider": "tsx --env-file-if-exists=.env src/cli.ts provider",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run validate && npm run build"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
